#!/bin/sh
# Reconstructed from Gemini instructions; requires original BusyBox rootfs.
echo '[ LAB-02 ] Starting system initialization...'
mount -t proc none /proc 2>/dev/null || true
mount -t sysfs none /sys 2>/dev/null || true
mount -t tmpfs none /tmp 2>/dev/null || true
mount -t devtmpfs none /dev 2>/dev/null || true
hostname embedded-lab2
MODULE_FILE=/lib/modules/5.15.0/lab2_driver.ko
if [ -f "$MODULE_FILE" ]; then
    if insmod "$MODULE_FILE"; then
        echo '[ LAB-02 ] lab2_driver loaded OK'
        [ -e /dev/lab2 ] || mknod /dev/lab2 c 240 0
        chmod 666 /dev/lab2
        echo '[ LAB-02 ] /dev/lab2 created (major=240, minor=0)'
    else
        echo '[ LAB-02 ] ERROR: insmod failed'
    fi
else
    echo '[ LAB-02 ] WARNING: module not found'
fi
echo '[ LAB-02 ] System initialization complete!'
